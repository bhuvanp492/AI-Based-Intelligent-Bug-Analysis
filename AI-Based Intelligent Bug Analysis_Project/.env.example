# Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Flask Application Environment ('development' or 'production')
FLASK_ENV=production

# Application Secret Key (Generate a random 32-byte secret for production)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# SQLite Database Location (Absolute or workspace-relative path)
DATABASE_PATH=instance/application.db

# Model Serialization Directory
TRAINED_MODELS_DIR=trained_models

# Upload Storage Directory
UPLOAD_FOLDER=instance/uploads

# Server Port
PORT=5000
